rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Classement public : nom + score uniquement, aucune donnée personnelle.
       C'est la seule collection que le site lit — donc la seule qu'un
       visiteur ou un scanner automatisé peut consulter.
       Un seul document par nom (l'id du document = nom normalisé côté client) :
       la création sert au premier passage, la mise à jour n'est acceptée que
       si le nouveau score bat l'ancien — jamais l'inverse. */
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name','score','at']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 24 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 20000 &&
        request.resource.data.at is string;

      allow update: if
        request.resource.data.keys().hasOnly(['name','score','at']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 24 &&
        request.resource.data.score is int &&
        request.resource.data.score > resource.data.score &&
        request.resource.data.score <= 20000 &&
        request.resource.data.at is string;

      allow delete: if false;
    }

    /* Contacts complets (e-mail, consentement) : jamais lisibles depuis le site
       ni par personne d'autre — uniquement consultables dans cette console
       Firebase. Sans authentification réelle (Firebase Auth), on ne peut pas
       distinguer "l'admin du stand" d'un visiteur quelconque, donc le seul
       choix sûr est d'interdire la lecture à tout le monde. */
    match /entries/{entryId} {
      allow read: if false;

      allow create: if
        request.resource.data.keys().hasOnly(['name','email','consent','score','at']) &&
        request.resource.data.name is string  && request.resource.data.name.size()  <= 24 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 80 &&
        request.resource.data.consent is bool &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 20000 &&
        request.resource.data.at is string;

      allow update, delete: if false;
    }
  }
}
