rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      // Le classement doit être lisible par tout le monde (public en ligne).
      allow read: if true;

      // N'importe qui peut ajouter une partie, mais seulement au bon format,
      // avec un score plausible — pas de triche grossière ni de champs en trop.
      allow create: if
        request.resource.data.keys().hasOnly(['name','email','consent','score','at']) &&
        request.resource.data.name is string  && request.resource.data.name.size()  <= 24 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 80 &&
        request.resource.data.consent is bool &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 20000 &&
        request.resource.data.at is string;

      // Personne ne peut modifier ou supprimer un score depuis le site :
      // un reset se fait volontairement à la main depuis cette console,
      // pour qu'aucun visiteur ne puisse effacer le classement à distance.
      allow update, delete: if false;
    }
  }
}
